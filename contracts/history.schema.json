{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "seq": {
            "type": "integer",
            "minimum": 0
          },
          "received_ns": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,19})$"
          },
          "kind": {
            "enum": [
              "log",
              "metric"
            ]
          },
          "namespace": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,256}$"
          },
          "instance": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,256}$"
          },
          "observed_ns": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,19})$"
          },
          "name": {
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,19})$"
              },
              {
                "type": "null"
              }
            ]
          },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "node_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._:-]{1,256}$"
              },
              "runtime": {
                "enum": [
                  "claude-code",
                  "codex",
                  "omp",
                  "pi",
                  "stub",
                  "terminal"
                ]
              },
              "label": {
                "type": "string"
              },
              "departure_state": {
                "enum": [
                  "blocked",
                  "canceled",
                  "denied",
                  "done",
                  "failed",
                  "handed-off",
                  "in-progress",
                  "pending"
                ]
              },
              "closure_reason": {
                "enum": [
                  "blocked_on",
                  "canceled",
                  "denied",
                  "escalation",
                  "handed_off_to",
                  "no-follow-on",
                  "superseded"
                ]
              },
              "start_ns": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,19})$"
              },
              "boot_epoch": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._:-]{1,256}$"
              },
              "transition_id": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,19})$"
              },
              "coverage": {
                "enum": [
                  "partial",
                  "retained_window",
                  "unavailable"
                ]
              },
              "prior_generation": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._:-]{1,256}$"
              },
              "new_generation": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._:-]{1,256}$"
              },
              "continuity": {
                "const": "intermediate_changes_unknown"
              },
              "occurred_ns": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,19})$"
              },
              "gap_id": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,19})$"
              },
              "gap_from": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,19})$"
              },
              "gap_through": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,19})$"
              },
              "identity_provenance": {
                "enum": [
                  "claimed:v1",
                  "origin-unknown:v1",
                  "principal:v1",
                  "relay:v1",
                  "transport:v1"
                ]
              }
            },
            "required": []
          }
        },
        "required": [
          "seq",
          "received_ns",
          "kind",
          "namespace",
          "instance",
          "observed_ns",
          "name",
          "value",
          "data"
        ]
      }
    },
    "next_cursor": {
      "type": "integer",
      "minimum": 0
    },
    "has_more": {
      "type": "boolean"
    }
  },
  "required": [
    "rows",
    "next_cursor",
    "has_more"
  ]
}
