{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "1.1.0"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "roster": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "seat": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}\\.[a-z][a-z0-9-]{0,62}$"
          },
          "team": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          },
          "runtime": {
            "enum": [
              "claude-code",
              "codex",
              "omp",
              "pi",
              "stub",
              "terminal"
            ]
          }
        },
        "required": [
          "seat",
          "team",
          "runtime"
        ]
      }
    },
    "namespace": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,256}$",
      "maxLength": 128
    },
    "ttl_seconds": {
      "type": "integer",
      "minimum": 10,
      "maximum": 600
    },
    "bindings": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:-]{1,256}$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,62}\\.[a-z][a-z0-9-]{0,62}$"
      },
      "maxProperties": 128
    }
  },
  "required": [
    "version",
    "project_id",
    "title",
    "roster",
    "namespace",
    "ttl_seconds",
    "bindings"
  ]
}
