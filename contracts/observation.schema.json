{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "enum": [
        "log",
        "metric"
      ]
    },
    "namespace": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,256}$"
    },
    "instance": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,256}$"
    },
    "observed_ns": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "name": {
      "type": "string"
    },
    "value": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        {
          "type": "null"
        }
      ]
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "node_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,256}$"
        },
        "runtime": {
          "enum": [
            "claude-code",
            "codex",
            "omp",
            "pi",
            "stub",
            "terminal"
          ]
        },
        "label": {
          "type": "string"
        },
        "departure_state": {
          "enum": [
            "blocked",
            "canceled",
            "denied",
            "done",
            "failed",
            "handed-off",
            "in-progress",
            "pending"
          ]
        },
        "closure_reason": {
          "enum": [
            "blocked_on",
            "canceled",
            "denied",
            "escalation",
            "handed_off_to",
            "no-follow-on",
            "superseded"
          ]
        },
        "start_ns": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "boot_epoch": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,256}$"
        },
        "transition_id": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "coverage": {
          "enum": [
            "partial",
            "retained_window",
            "unavailable"
          ]
        },
        "prior_generation": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,256}$"
        },
        "new_generation": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,256}$"
        },
        "continuity": {
          "const": "intermediate_changes_unknown"
        },
        "occurred_ns": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "gap_id": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "gap_from": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "gap_through": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "identity_provenance": {
          "enum": [
            "claimed:v1",
            "origin-unknown:v1",
            "principal:v1",
            "relay:v1",
            "transport:v1"
          ]
        }
      },
      "required": []
    }
  },
  "required": [
    "kind",
    "namespace",
    "instance",
    "observed_ns",
    "name",
    "value",
    "data"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "metric"
          }
        }
      },
      "then": {
        "properties": {
          "name": {
            "enum": [
              "openrig.queue.state.duration",
              "openrig.queue.transition.observed",
              "openrig.seat.activity",
              "openrig.seat.needs_input",
              "openrig.seat.presence",
              "openrig.telemetry.coverage.gap",
              "openrig.telemetry.failure"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "log"
          }
        }
      },
      "then": {
        "properties": {
          "name": {
            "enum": [
              "openrig.queue.transition",
              "openrig.seat.tenure_change.observed",
              "openrig.telemetry.failure",
              "openrig.telemetry.gap"
            ]
          },
          "value": {
            "type": "null"
          }
        }
      }
    }
  ]
}
